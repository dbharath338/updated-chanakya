# Copy to .env and fill in your keys
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Optional overrides
# openai/gpt-oss-120b (Deep, default) or openai/gpt-oss-20b (Fast)
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high  (higher = better lessons, slower first step)
GROQ_REASONING_EFFORT=low
DEEPGRAM_VOICE=aura-2-thalia-en
DEEPGRAM_STT_MODEL=nova-3
# "en" for English, "multi" for code-switching (e.g. Hinglish)
DEEPGRAM_STT_LANGUAGE=multi
PORT=8000
