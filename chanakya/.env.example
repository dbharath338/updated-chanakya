# Everything here is OPTIONAL. With no keys at all, Chanakya still teaches every
# curriculum topic from its built-in offline lesson library and speaks with your
# browser's own voice. Copy to .env only if you want the AI tutor and Deepgram voice.

# --- Language model (Groq) ---------------------------------------------------
# Without this key, lessons come from the offline library - no API calls at all.
GROQ_API_KEY=
# auto   = use the model, fall back to the offline library if it is rate limited
# offline = never call the model (zero API usage, zero rate limits)
AI_MODE=auto
# openai/gpt-oss-120b (Deep, default) or openai/gpt-oss-20b (Fast).
# If one model hits its daily token limit, the other is tried automatically.
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high  (higher = better lessons, slower first step)
GROQ_REASONING_EFFORT=low

# --- Voice (Deepgram) --------------------------------------------------------
# Without this key, speech and the microphone use the browser's built-in engines.
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-thalia-en
DEEPGRAM_STT_MODEL=nova-3
# "en" for English, "multi" for code-switching (e.g. Hinglish)
DEEPGRAM_STT_LANGUAGE=multi

PORT=8000
